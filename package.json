{
  "name": "spielberg-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "server": "npm run build && npm run backend:dev",
    "server:build": "npm run build && npm run backend:build",
    "server:build:linux-arm64": "./scripts/build-linux-arm64.sh",
    "desktop:build": "tauri build",
    "desktop:dmg": "./scripts/build-dmg.sh",
    "frontend:dev": "vite",
    "backend:dev": "cargo run --manifest-path backend/Cargo.toml",
    "backend:build": "cargo build --release --manifest-path backend/Cargo.toml",
    "test:api": "python3 scripts/qa/http-api.py"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
